@echo off
cd /d "%~dp0.."
chcp 65001 >nul
title أداة تصدير كتب المكتبة الشاملة إلى Word (DOCX)
color 0B

:MENU
cls
echo ===============================================================================
echo                📚 منظومة تصدير كتب المكتبة الشاملة إلى WORD DOCX 📚
echo ===============================================================================
echo   قاعدة البيانات تضم 250 كتاباً كاملاً (1,200 مجلد، 550,192 صفحة)
echo   مع الفهارس التفصيلية الكاملة وتلوين النصوص والوسوم بدقة 100%%
echo ===============================================================================
echo.
echo   [1] تصدير أمهات الكتب الرئيسية (الكافي، الاستبصار، من لا يحضره الفقيه، الخ)
echo   [2] تصدير كتاب محدد (بالاسم أو برقم المعرف)
echo   [3] توليد الفهرس العام الشامل لجميع الكتب الـ 250 (DOCX + JSON + CSV)
echo   [4] تصدير جميع كتب المكتبة الـ 250 دفعة واحدة
echo   [5] فتح مجلد الكتب المصدرة (كتب_المكتبة_docx)
echo   [6] خروج
echo.
echo ===============================================================================
set /p opt="> اختر رقم العملية [1-6]: "

if "%opt%"=="1" (
    cls
    echo جاري تصدير أمهات الكتب الرئيسية...
    python -u "%~dp0export_library_to_docx.py" --top
    echo.
    echo تم الانتهاء! اضغط أي مفتاح للعودة...
    pause >nul
    goto MENU
)

if "%opt%"=="2" (
    cls
    set /p bname="أدخل رقم الكتاب أو جزء من اسمه: "
    python -u "%~dp0export_library_to_docx.py" --book %bname%
    echo.
    echo اضغط أي مفتاح للعودة...
    pause >nul
    goto MENU
)

if "%opt%"=="3" (
    cls
    echo جاري توليد وثيقة الفهرس العام الشامل...
    python -u "%~dp0export_library_to_docx.py" --catalog
    echo.
    echo اضغط أي مفتاح للعودة...
    pause >nul
    goto MENU
)

if "%opt%"=="4" (
    cls
    echo تحذير: سيتم الآن تصدير 250 كتاباً (1,200 مجلد) إلى ملفات Word منسقة.
    set /p cnf="هل أنت متأكد من المتابعة؟ (y/n): "
    if /i "%cnf%"=="y" (
        python -u "%~dp0batch_export_all_books.py"
    )
    echo.
    echo اضغط أي مفتاح للعودة...
    pause >nul
    goto MENU
)

if "%opt%"=="5" (
    start "" "كتب_المكتبة_docx"
    goto MENU
)

if "%opt%"=="6" (
    exit
)

goto MENU
